---
/**
 * The content pillars redbull.com/br-pt files its stories under. Each card
 * fills with red from the bottom on hover and lifts its own title.
 */
const disciplines = [
	{
		name: 'Bike',
		copy: 'Freeride, downhill urbano e trail. Do Rampage nas montanhas de Utah às ladeiras de Valparaíso.',
	},
	{
		name: 'Skate',
		copy: 'Park, street e bowl. A cena brasileira que virou potência olímpica, filmada de dentro.',
	},
	{
		name: 'Surfe',
		copy: 'Big wave, tour mundial e as ondas que ninguém tinha remado antes.',
	},
	{
		name: 'Esporte a Motor',
		copy: 'Fórmula 1, rali, motocross e drift. Da pista fechada ao asfalto aberto.',
	},
	{
		name: 'Gaming',
		copy: 'eSports, campeonatos e os bastidores de quem joga para viver.',
	},
	{
		name: 'Dança',
		copy: 'Breaking, freestyle e batalhas decididas no compasso de um round.',
	},
	{
		name: 'Música',
		copy: 'Do freestyle de rima ao palco sinfônico. Encontros que só acontecem uma vez.',
	},
];

/** Accent- and space-safe anchor id. */
const slug = (value: string) =>
	value
		.toLowerCase()
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');
---

<section class="disciplines" id="universo" aria-labelledby="disciplines-title">
	<header class="disciplines__head">
		<p class="eyebrow" data-reveal>O universo</p>
		<h2 class="disciplines__title" id="disciplines-title" data-reveal style="--i:1">
			Sete territórios,<br />uma mesma lata.
		</h2>
		<p class="disciplines__lede" data-reveal style="--i:2">
			A Red Bull não patrocina esporte, ela produz o que acontece nele. Cada território
			abaixo é uma frente inteira de eventos, atletas e histórias.
		</p>
	</header>

	<ul class="grid">
		{disciplines.map((discipline, index) => (
			<li class="card" id={slug(discipline.name)} data-reveal style={`--i:${index % 4}`}>
				<a class="card__link" href={`#${slug(discipline.name)}`}>
					<span class="card__index">{String(index + 1).padStart(2, '0')}</span>
					<h3 class="card__name">{discipline.name}</h3>
					<p class="card__copy">{discipline.copy}</p>
					<span class="card__arrow" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<path
								d="M5 12h13M12.5 5.8 18.8 12l-6.3 6.2"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.disciplines {
		position: relative;
		padding: var(--section-y) 0;
	}

	.disciplines__head,
	.grid {
		width: var(--shell);
		margin-inline: auto;
	}

	.eyebrow {
		margin: 0 0 1.2rem;
		font-family: Poppins, sans-serif;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--rb-red);
	}

	.disciplines__title {
		margin: 0;
		font-family: Poppins, sans-serif;
		font-size: clamp(2.2rem, 6vw, 4.6rem);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.03em;
	}

	.disciplines__lede {
		max-width: 46ch;
		margin: 1.6rem 0 0;
		font-size: clamp(0.95rem, 1.5vw, 1.1rem);
		line-height: 1.6;
		color: var(--ink-dim);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: 1px;
		margin-top: clamp(3rem, 6vw, 5rem);
		padding: 0;
		list-style: none;
		background: var(--ink-faint);
		border: 1px solid var(--ink-faint);
	}

	.card {
		position: relative;
		background: rgba(255, 255, 255, 0.78);
		isolation: isolate;
	}

	.card__link {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		min-height: clamp(15rem, 22vw, 19rem);
		padding: clamp(1.4rem, 2.4vw, 2rem);
		color: inherit;
		text-decoration: none;
	}

	/* The red flood, anchored to the bottom edge. */
	.card__link::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, #a6082f 0%, var(--rb-red) 100%);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.card__link:hover::before,
	.card__link:focus-visible::before {
		transform: scaleY(1);
	}

	.card__index {
		font-family: Poppins, sans-serif;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		color: var(--ink-dim);
		transition: color var(--transition);
	}

	.card__name {
		margin: auto 0 0;
		font-family: Poppins, sans-serif;
		font-size: clamp(1.5rem, 2.6vw, 2.1rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
		transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.card__copy {
		margin: 0;
		max-height: 0;
		font-size: 0.92rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.86);
		opacity: 0;
		overflow: hidden;
		transition: max-height 520ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 340ms ease;
	}

	.card__link:hover .card__name,
	.card__link:focus-visible .card__name {
		transform: translateY(-0.2rem);
	}

	.card__link:hover .card__copy,
	.card__link:focus-visible .card__copy {
		max-height: 9rem;
		opacity: 1;
	}

	.card__link:hover .card__index,
	.card__link:focus-visible .card__index {
		color: rgba(255, 255, 255, 0.8);
	}

	.card__link:hover .card__name,
	.card__link:focus-visible .card__name {
		color: #fff;
	}

	.card__link:hover .card__arrow,
	.card__link:focus-visible .card__arrow {
		color: #fff;
	}

	.card__arrow {
		position: absolute;
		top: clamp(1.4rem, 2.4vw, 2rem);
		right: clamp(1.4rem, 2.4vw, 2rem);
		width: 1.4rem;
		height: 1.4rem;
		color: var(--ink);
		opacity: 0;
		transform: translate(-0.4rem, 0.4rem);
		transition: opacity var(--transition), transform var(--transition);
	}

	.card__arrow svg {
		width: 100%;
		height: 100%;
	}

	.card__link:hover .card__arrow,
	.card__link:focus-visible .card__arrow {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.card__link::before,
		.card__name,
		.card__copy,
		.card__arrow {
			transition-duration: 1ms;
		}
	}
</style>
