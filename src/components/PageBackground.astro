---
/**
 * The living backdrop for everything below the hero: three slow aurora blobs in
 * CSS (free, GPU-composited) and a carbonation field on a canvas that answers
 * to the pointer and to the scroll.
 *
 * It sits at z-index -1, fixed, so the sections above it only need translucent
 * backgrounds to let it through.
 */
---

<div class="page-bg" aria-hidden="true">
	<div class="page-bg__aurora">
		<span class="blob blob--red"></span>
		<span class="blob blob--navy"></span>
		<span class="blob blob--gold"></span>
	</div>
	<canvas class="page-bg__canvas" id="page-bg-canvas"></canvas>
</div>

<style>
	.page-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		background: var(--paper);
	}

	.page-bg__aurora,
	.page-bg__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* The pointer nudges the whole aurora, so the colour field has a little
	   depth against the bubbles in front of it. */
	.page-bg__aurora {
		transform: translate3d(
			calc(var(--pointer-x, 0) * 26px),
			calc(var(--pointer-y, 0) * 20px),
			0
		);
		transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
		will-change: transform;
	}

	.blob--red {
		top: -12%;
		left: -8%;
		width: 62vw;
		height: 62vw;
		background: radial-gradient(closest-side, rgba(219, 10, 64, 0.13), rgba(219, 10, 64, 0));
		animation: blob-a 31s ease-in-out infinite alternate;
	}

	.blob--navy {
		bottom: -18%;
		right: -10%;
		width: 70vw;
		height: 70vw;
		background: radial-gradient(closest-side, rgba(34, 57, 113, 0.16), rgba(34, 57, 113, 0));
		animation: blob-b 43s ease-in-out infinite alternate;
	}

	.blob--gold {
		top: 34%;
		left: 46%;
		width: 40vw;
		height: 40vw;
		background: radial-gradient(closest-side, rgba(255, 184, 28, 0.16), rgba(255, 184, 28, 0));
		animation: blob-c 37s ease-in-out infinite alternate;
	}

	@keyframes blob-a {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(14vw, 10vh, 0) scale(1.25);
		}
	}

	@keyframes blob-b {
		from {
			transform: translate3d(0, 0, 0) scale(1.1);
		}
		to {
			transform: translate3d(-16vw, -12vh, 0) scale(0.9);
		}
	}

	@keyframes blob-c {
		from {
			transform: translate3d(-8vw, 6vh, 0) scale(0.85);
		}
		to {
			transform: translate3d(10vw, -8vh, 0) scale(1.3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-bg__aurora {
			transition: none;
			transform: none;
		}

		.blob {
			animation: none;
		}
	}
</style>

<script>
	import { initBackground } from '../scripts/background';

	initBackground();
</script>
